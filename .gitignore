# Môi trường Python và tệp sinh tự động; vẫn đưa requirements.txt lên Git.
/.venv/
/venv/
/env/
__pycache__/
*.py[cod]
*.egg-info/
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/
/build/
/dist/

# Dữ liệu gốc giữ ở máy; kết quả trong output được đưa lên Git.
/vintext/
/vintext_original/

*.pth
*.pt
*.ckpt
*.onnx

# Bản nén dữ liệu và nhật ký.
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.log

# Giữ toàn bộ output, gồm crop, báo cáo, nhật ký và checkpoint.
!/output/
!/output/**

# Cấu hình riêng của máy và thông tin môi trường.
.env
.env.*
!.env.example
/.vscode/
/.idea/
/.codex/
/.aws/
Thumbs.db
.DS_Store
